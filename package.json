{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "sync-webfonts": "mkdir -p resources/webfonts && cp -R node_modules/@fortawesome/fontawesome-free/webfonts/. resources/webfonts/",
        "postinstall": "npm run sync-webfonts"
    },
    "devDependencies": {
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@popperjs/core": "^2.11.8",
        "alpinejs": "^3.17.4",
        "bootstrap": "^5.3.8",
        "htmx.org": "^2.0.11",
        "sass": "^1.105.1"
    }
}
